{
  "planVersion": 1,
  "site": "yp-for-business",
  "origins": {
    "metrics": "https://mymetrics.yp.ca",
    "ypapi": "https://ypapi.ypcloud.io"
  },
  "tabFor": {
    "metrics": "mymetrics.yp.ca",
    "ypapi": "ypforbusiness.yellowpages.ca"
  },
  "loginPaths": [
    "/login",
    "b2clogin\\.com",
    "[sS]imple[sS][aA][mM][lL]|/saml"
  ],
  "probe": {
    "metrics": "/server/api/nav/app",
    "ypapi": "/bc/v1/app-services/maintenance"
  },
  "headers": {
    "authorization": {
      "fromPageResponse": {
        "origin": "ypapi",
        "urlPattern": "app-services/authenticate",
        "path": "$.data.securityToken"
      },
      "prefix": "Bearer "
    }
  },
  "values": {
    "ypapiUid": {
      "fromPageResponse": {
        "origin": "ypapi",
        "urlPattern": "app-services/authenticate",
        "path": "$.data.uid"
      }
    }
  },
  "ids": {
    "userId": {
      "endpoint": "session-init-user",
      "path": "$.data.settings.userId"
    },
    "dashId": {
      "endpoint": "dash-pages",
      "path": "$.data.aaData[].id",
      "fallbackLiterals": [
        92,
        139
      ]
    },
    "widgetId": {
      "endpoint": "dash-detail",
      "path": "$.data.page.widget_ids[]"
    },
    "serviceId": {
      "endpoint": "dash-detail",
      "path": "$.data.page.data_sources[].data_source_id"
    },
    "accountId": {
      "endpoint": "ypapi-account",
      "path": "$.data.accounts[].accountNumber"
    },
    "analyticId": {
      "endpoint": "ypapi-account",
      "path": "$.data.accounts[].accountNumber"
    },
    "merchantId": {
      "endpoint": "ypapi-account",
      "path": "$.data.accounts[].merchants[].merchantId"
    }
  },
  "widgetRules": {
    "dashIdsFrom": "dashId",
    "endpointTemplate": {
      "widget": "widget-data"
    },
    "widgetIdParam": "widget_request",
    "pageIdParam": "widget_page_id",
    "literals": {
      "timegrouping": "month"
    },
    "queryFromWidget": {
      "widget_type": {
        "path": "$.type"
      },
      "fields": {
        "path": "$.metadata.data_columns.selected[].field",
        "join": ","
      },
      "groupby": {
        "path": "$.metadata.data_columns.grouped[].field",
        "join": ","
      },
      "filter_set_id": {
        "path": "$.metadata.filter_set_id"
      },
      "timegrouping": {
        "path": "$.metadata.time_grouping"
      }
    }
  },
  "endpoints": [
    {
      "id": "session-init-user",
      "docId": "GET mymetrics.yp.ca/server/api/session/initUser",
      "origin": "metrics",
      "method": "GET",
      "path": "/server/api/session/initUser",
      "query": {
        "is_nui": true,
        "query_id": {
          "computed": "uuid"
        }
      },
      "paginator": {
        "kind": "none"
      },
      "group": "account",
      "yields": {
        "userId": "$.data.settings.userId"
      }
